{
	"private": true,
	"name": "@tc39/data",
	"version": "0.0.0",
	"description": "TC39's source of truth for programmatically available delegate, process, and proposal data.",
	"main": false,
	"scripts": {
		"prepare": "node generate-types.mjs",
		"preversion": "echo \"use \\`npm run --no-workspaces version\\` in a subpackage directly\" && exit 1",
		"prelint": "node generate-types.mjs",
		"lint": "eslint .",
		"postlint": "tsc && npm run prepack --if-present --dry-run -w data/${*}",
		"pretest": "npm run lint",
		"pretests-only": "node generate-types.mjs",
		"tests-only": "c8 tape 'test/**/*.mjs'",
		"test": "npm run tests-only",
		"posttest": "npx npm@'>=10.2' audit --production",
		"dependencies": "node -p \"process.env.npm_command\" | npx \"dt-clean@^1.2.2\" --auto"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tc39/data.git"
	},
	"author": "",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/tc39/data/issues"
	},
	"homepage": "https://github.com/tc39/data#readme",
	"engines": {
		"node": ">= 26.8"
	},
	"workspaces": [
		"data/*"
	],
	"devDependencies": {
		"@ljharb/eslint-config": "^22.2.4",
		"@ljharb/tsconfig": "^0.3.2",
		"@types/node": "^26.4.1",
		"ajv": "^8.20.0",
		"c8": "^12.0.0",
		"in-publish": "^2.0.1",
		"safe-publish-latest": "^2.0.0",
		"tape": "^5.10.2",
		"typescript": "next"
	}
}
