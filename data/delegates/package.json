{
	"name": "@tc39/data-delegates",
	"version": "1.0.0",
	"description": "TC39 delegates data",
	"main": "index.json",
	"types": "./index.d.ts",
	"exports": {
		".": {
			"types": "./index.d.ts",
			"default": "./index.json"
		},
		"./schema.json": "./schema.json",
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"scripts": {
		"prepack": "node ../../generate-types.mjs && npmignore --auto --commentLines=autogenerated",
		"prepublishOnly": "safe-publish-latest && cp ../../LICENSE ./",
		"prepublish": "not-in-publish || npm run prepublishOnly",
		"prelint": "node ../../generate-types.mjs",
		"lint": "eslint .",
		"postlint": "tsc && attw -P",
		"pretest": "npm run lint",
		"test": ">&2 echo tests are ran in the monorepo only",
		"posttest": "npx npm@'>=10.2' audit --production",
		"version": "node ../../release.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tc39/data.git",
		"directory": "./data/delegates"
	},
	"directories": {
		"test": false
	},
	"license": "MIT",
	"devDependencies": {
		"@arethetypeswrong/cli": "^0.18.5",
		"@ljharb/eslint-config": "^22.2.4",
		"auto-changelog": "^2.6.0",
		"eslint": "^10.9.1",
		"in-publish": "^2.0.1",
		"npmignore": "^0.3.5",
		"safe-publish-latest": "^2.0.0",
		"typescript": "next"
	},
	"publishConfig": {
		"ignore": [
			"eslint.config.mjs",
			"tsconfig.json"
		]
	},
	"auto-changelog": {
		"output": "CHANGELOG.md",
		"template": "keepachangelog",
		"unreleased": false,
		"commitLimit": false,
		"backfillLimit": false,
		"hideCredit": true,
		"appendGitLog": ".",
		"tagPrefix": "delegates@"
	}
}
